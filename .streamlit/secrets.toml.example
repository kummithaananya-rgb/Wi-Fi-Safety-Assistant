# ============================================================
# Streamlit Cloud Secrets — copy contents of your .env here
# In Streamlit Cloud: App settings → Secrets → paste below
# ============================================================

IBM_CLOUD_API_KEY       = "your_ibm_cloud_api_key_here"
IBM_WATSONX_PROJECT_ID  = "your_watsonx_project_id_here"
IBM_WATSONX_URL         = "https://us-south.ml.cloud.ibm.com"
IBM_GRANITE_MODEL_ID    = "ibm/granite-4-h-small"

GOOGLE_GEMINI_API_KEY   = "your_gemini_api_key_here"
GEMINI_MODEL_ID         = "models/gemini-2.0-flash"

FLASK_SECRET_KEY        = "change-this-to-a-long-random-string"
SQLITE_DB_PATH          = "wifi_safety.db"

RATE_LIMIT_PER_MINUTE   = "30"
MAX_INPUT_LENGTH        = "2000"
ENABLE_GUARDRAILS       = "true"
LOG_LEVEL               = "INFO"
