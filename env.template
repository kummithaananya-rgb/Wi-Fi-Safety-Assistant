# =====================================================
# COPY THIS FILE TO .env AND FILL IN YOUR API KEYS
# NEVER commit .env to version control
# =====================================================

# --- IBM Cloud / watsonx.ai ---
IBM_CLOUD_API_KEY=PASTE_YOUR_IBM_CLOUD_API_KEY_HERE
IBM_WATSONX_PROJECT_ID=PASTE_YOUR_WATSONX_PROJECT_ID_HERE
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com
IBM_GRANITE_MODEL_ID=ibm/granite-4-h-small

# --- Flask ---
FLASK_SECRET_KEY=change_this_to_a_random_secret_key_in_production
FLASK_DEBUG=False
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# --- Database (SQLite auto-used if MySQL not configured) ---
SQLITE_DB_PATH=wifi_safety.db
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=wifi_safety_db

# --- Security ---
RATE_LIMIT_PER_MINUTE=30
MAX_INPUT_LENGTH=2000
ENABLE_GUARDRAILS=true

# --- Logging ---
LOG_LEVEL=INFO
