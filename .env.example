# =============================================================
# Wi-Fi Safety Assistant - Environment Variables (EXAMPLE)
# Copy to .env and fill in your real credentials.
# NEVER commit .env to version control.
# =============================================================

# -- IBM watsonx.ai - PRIMARY AI MODEL ------------------------
# Get at: https://cloud.ibm.com/iam/apikeys
IBM_CLOUD_API_KEY=your_ibm_cloud_api_key_here
# Get at: https://dataplatform.cloud.ibm.com/projects/
IBM_WATSONX_PROJECT_ID=your_watsonx_project_id_here
IBM_WATSONX_URL=https://eu-de.ml.cloud.ibm.com
IBM_GRANITE_MODEL_ID=ibm/granite-4-h-small

# -- Google Gemini - SECONDARY AI MODEL / FALLBACK ------------
# Get at: https://aistudio.google.com/app/apikey
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_ID=models/gemini-3.5-flash

# -- Flask ----------------------------------------------------
FLASK_SECRET_KEY=change-this-to-a-long-random-string-in-production
FLASK_DEBUG=False
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# -- Database (SQLite auto-used if MySQL not configured) ------
SQLITE_DB_PATH=wifi_safety.db
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=wifi_safety_db

# -- Security -------------------------------------------------
RATE_LIMIT_PER_MINUTE=30
MAX_INPUT_LENGTH=2000
ENABLE_GUARDRAILS=true

# -- Logging --------------------------------------------------
LOG_LEVEL=INFO
